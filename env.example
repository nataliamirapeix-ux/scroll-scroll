# Copiar estas tres variables en Vercel > Project > Settings > Environment Variables
# (o en un archivo .env.local si se prueba en el ordenador con `vercel dev`)

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > service_role (secreta, nunca va al navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

